{
  "info": {
    "name": "mathApi - Postman Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health - Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Angulo - radianosparaGraus",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valor\": 3.141592653589793\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/angulo/radianosparagraus",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "angulo",
            "radianosparagraus"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Retorna envelope e conversão correta', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('resultado');",
              "  pm.expect(json.data.resultado).to.be.a('number');",
              "  pm.expect(json.data.resultado).to.be.closeTo(180, 0.000001);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Funcao - linear",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"a\": 2,\n  \"b\": 3,\n  \"x\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/funcao/linear",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "funcao",
            "linear"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Retorna envelope e resultado linear correto', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.include({ tipo: 'linear', resultado: 13 });",
              "  pm.expect(json.data.resultado).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    }
  ]
